pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    credentialsId: 'github_acc',
                    url: 'https://github.com/Dharshini-Karnan/devops-end-to-end-ci-cd-pipeline.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('app') {
                    bat 'docker build -t dharshinikarnan/devops-nodejs-app:1.0 .'
                }
            }
        }
    }

    post {
        success {
            echo 'Docker image built successfully'
        }
        failure {
            echo 'Build failed'
        }
    }
}
