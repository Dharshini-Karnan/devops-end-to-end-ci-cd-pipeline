pipeline {
    agent any

    environment {
        APP_NAME = "devops-nodejs-app"
        IMAGE_TAG = "1.0"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Dharshini-Karnan/devops-end-to-end-ci-cd-pipeline.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('app') {
                    sh 'docker build -t ${APP_NAME}:${IMAGE_TAG} .'
                }
            }
        }
    }

    post {
        success {
            echo "Docker image built successfully"
        }
        failure {
            echo "Build failed"
        }
    }
}
